<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>todo_list_modern</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
      <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
      <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
      <PackageReference Include="xunit" Version="2.9.3" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="**\*Tests.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <Compile Include="**\*Tests.cs" />
    </ItemGroup>

</Project>
